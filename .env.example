# ===== Nexus-Lark-Mind Environment =====

# App
APP_ENV=development
LOG_LEVEL=INFO
TZ=Asia/Shanghai

# Service ports (inside compose network)
KERNEL_HOST=0.0.0.0
KERNEL_PORT=8001
ORCHESTRATOR_HOST=0.0.0.0
ORCHESTRATOR_PORT=8002
ADAPTERS_HOST=0.0.0.0
ADAPTERS_PORT=8000

# Internal RPC
KERNEL_RPC_URL=http://core-kernel:8001
ORCHESTRATOR_RPC_URL=http://orchestrator:8002

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_TASK_QUEUE=nlm:tasks
REDIS_EVENT_CHANNEL=nlm:events
REDIS_SESSION_PREFIX=nlm:session:

# Storage (SQLite — ONLY core-kernel may access)
DATABASE_URL=sqlite+aiosqlite:///data/nexus.db

# Default model provider
DEFAULT_MODEL_PROVIDER=glm
DEFAULT_MODEL_NAME=glm-4.7-flash

# OpenAI-compatible (OpenAI / DeepSeek / local proxies)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini
OPENAI_MODELS=gpt-4o-mini,gpt-4o,gpt-4.1-mini,gpt-4.1

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_DEFAULT_MODEL=deepseek-chat
DEEPSEEK_MODELS=deepseek-chat,deepseek-reasoner

# 智谱 BigModel / GLM (OpenAI 兼容)
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_DEFAULT_MODEL=glm-4.7-flash
GLM_MODELS=glm-4.7-flash,glm-4-flash,glm-4.5-flash,glm-z1-flash,glm-4-plus

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_MODELS=claude-3-5-sonnet-20241022,claude-3-5-haiku-20241022,claude-sonnet-4-20250514

# Model gateway resilience (GLM free/flash often needs longer 429 backoff)
MODEL_MAX_RETRIES=8
MODEL_RETRY_BASE_SECONDS=2.0
MODEL_RETRY_MAX_SECONDS=60.0
MODEL_TIMEOUT_SECONDS=120
MODEL_CIRCUIT_FAILURE_THRESHOLD=5
MODEL_CIRCUIT_RESET_SECONDS=60

# Context compaction aggressiveness: conservative | balanced | aggressive
# conservative compresses later (fewer LLM summary calls); aggressive frees window earlier.
COMPACTION_AGGRESSIVENESS=balanced

# Feishu / Lark bot
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_USE_LONG_CONNECTION=true

# Plugin runtime
PLUGINS_DIR=/app/plugins_volume
PLUGIN_ISOLATION=true
CLI_AUTO_REGISTER=true

# Web search (optional). Empty → DuckDuckGo free fallback via ddgs.
# Get a key: https://app.tavily.com  |  MCP: https://github.com/tavily-ai/tavily-mcp
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic
# Optional: https://api.search.brave.com/  |  https://github.com/brave/brave-search-mcp-server
BRAVE_API_KEY=

# Image search (optional) — first configured provider wins
# SerpAPI Google Images: https://serpapi.com
SERPAPI_API_KEY=
# Azure Bing Image Search v7
BING_SEARCH_API_KEY=
# Unsplash / Pexels stock photos
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# Web adapter
WEB_STATIC_DIR=/app/web-static
CORS_ORIGINS=*

# Host folder mounted into core-kernel at /workspaces (Docker).
# Windows Docker Desktop examples:
#   NLM_HOST_WORKSPACE=E:/cursor/open_program
#   NLM_HOST_WORKSPACE=C:/Users/you/projects
# Linux / macOS:
#   NLM_HOST_WORKSPACE=/home/you/projects
# Leave empty / unset to use ./workspaces next to docker-compose.yml.
NLM_HOST_WORKSPACE=./workspaces
